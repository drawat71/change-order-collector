# Copy this file to .env and fill in your own PayPal Sandbox values.
# Never commit .env. See the "Live sandbox setup" section of README.md.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_INVOICER_EMAIL=

# Set to 1 to run in mock mode with no credentials and no PayPal calls.
PAYPAL_MOCK=
